package templates

import "github.com/lporcheron/quorum/internal/poll"

// pollMeta feeds link previews (the share gesture is the product) and
// keeps poll pages out of search indexes: their URLs are capabilities.
templ pollMeta(p PollPageProps) {
	<meta name="robots" content="noindex"/>
	<meta property="og:type" content="website"/>
	<meta property="og:title" content={ p.Poll.Title }/>
	if p.Poll.Description != "" {
		<meta property="og:description" content={ p.Poll.Description }/>
	} else {
		<meta property="og:description" content={ p.Loc.T("og.description") }/>
	}
	<meta property="og:site_name" content={ instanceName(ctx) }/>
	if p.OGImage != "" {
		<meta property="og:image" content={ p.OGImage }/>
		<meta name="twitter:card" content="summary_large_image"/>
	}
}

// PollPage is the public poll page: header, grid, comments.
templ PollPage(p PollPageProps) {
	@layoutWithMeta(p.Loc, p.Poll.Title+" — Quorum", p.User, pollMeta(p)) {
		if p.Updated {
			<p class="notice mt-6">{ p.Loc.T("vote.updated") }</p>
		}
		if p.JustJoined && p.EditURL != "" {
			<div class="banner mt-6">
				<p class="font-semibold">{ p.Loc.T("vote.edit_banner_title") }</p>
				<p class="mt-1 text-sm">{ p.Loc.T("vote.edit_banner_body") }</p>
				<div class="mt-2 flex gap-2">
					<input class="field flex-1 font-mono text-xs" type="text" readonly value={ p.EditURL } id="edit-url"/>
					<button class="btn btn-sm" type="button" data-copy="edit-url" data-copied={ p.Loc.T("admin.copied") }>{ p.Loc.T("admin.copy") }</button>
				</div>
			</div>
		}
		if p.Poll.Status == poll.StatusFinalized && p.FinalizedLabel != "" {
			<div class="banner mt-6">
				<p>
					<span class="font-semibold">{ p.Loc.T("poll.finalized_banner") }</span>
					<span class="ml-1 font-mono">{ p.FinalizedLabel }</span>
				</p>
				<p class="mt-2">
					<a class="btn btn-sm" href={ templ.URL(p.pollPath("/calendar.ics")) }>{ p.Loc.T("poll.ics") }</a>
				</p>
			</div>
		}
		if p.Poll.Status == poll.StatusCancelled {
			<p class="error mt-6">{ p.Loc.T("poll.cancelled_banner") }</p>
		}
		<div class="mt-8">
			<h1 class="font-display text-4xl font-semibold tracking-tight">{ p.Poll.Title }</h1>
			if p.Poll.Description != "" {
				<p class="mt-2 max-w-prose whitespace-pre-line text-ink/80">{ p.Poll.Description }</p>
			}
			<div class="mt-2 flex flex-wrap gap-x-6 gap-y-1 text-sm text-ink/70">
				if p.Poll.Location != "" {
					<span>📍 { p.Poll.Location }</span>
				}
				if p.Poll.VideoURL != "" {
					<a class="underline" href={ templ.URL(p.Poll.VideoURL) } rel="noopener">{ p.Loc.T("poll.video_join") }</a>
				}
			</div>
		</div>
		@Grid(p)
		@commentsSection(p)
	}
}

templ commentsSection(p PollPageProps) {
	if p.Poll.AllowComments {
		<section class="mt-12 max-w-2xl">
			<h2 class="font-display text-lg font-semibold">{ p.Loc.T("comments.heading") }</h2>
			if len(p.View.Comments) == 0 {
				<p class="mt-2 text-sm text-ink/60">{ p.Loc.T("comments.empty") }</p>
			}
			<ul class="mt-3 space-y-3">
				for _, c := range p.View.Comments {
					<li class="border-l-2 border-ink/20 pl-3">
						<p class="text-sm">
							<span class="font-semibold">{ c.AuthorName }</span>
							<span class="ml-2 font-mono text-xs text-ink/50">{ Stamp(p.lang(), c.CreatedAt, p.TZ) }</span>
						</p>
						<p class="mt-0.5 whitespace-pre-line text-sm">{ c.Body }</p>
						if p.Me != nil && c.ParticipantID == p.Me.ID {
							<form method="post" action={ templ.URL(p.pollPath("/p/" + p.EditToken + "/comments/" + itoa(c.ID) + "/delete")) }>
								<button class="btn-link text-xs" type="submit">{ p.Loc.T("comments.delete") }</button>
							</form>
						}
					</li>
				}
			</ul>
			<form method="post" action={ templ.URL(p.pollPath("/comments")) } class="mt-5 space-y-2">
				if p.Me != nil {
					<input type="hidden" name="ptoken" value={ p.EditToken }/>
				} else {
					<label class="block">
						<span class="lbl">{ p.Loc.T("comments.name_label") }</span>
						<input class="field" type="text" name="author_name" required/>
					</label>
				}
				<label class="block">
					<span class="lbl">{ p.Loc.T("comments.body_label") }</span>
					<textarea class="field w-full" name="body" rows="2" required></textarea>
				</label>
				<button class="btn" type="submit">{ p.Loc.T("comments.submit") }</button>
			</form>
		</section>
	}
}
