package templates

import (
	"github.com/lporcheron/quorum/internal/auth"
	"github.com/lporcheron/quorum/internal/i18n"
)

templ layout(loc *i18n.Locale, title string, user *auth.User) {
	<!DOCTYPE html>
	<html lang={ loc.Lang }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="icon" type="image/svg+xml" href="/static/favicon.svg"/>
			<link rel="icon" type="image/png" sizes="32x32" href="/static/favicon-32.png"/>
			<link rel="stylesheet" href="/static/css/app.css"/>
			<script src="/static/js/htmx.min.js" defer></script>
			<script src="/static/js/quorum.js" defer></script>
		</head>
		<body class="flex min-h-screen flex-col bg-paper font-sans text-ink antialiased">
			<header class="border-b border-ink/15">
				<div class="mx-auto flex h-12 max-w-5xl items-center justify-between px-4">
					<a href="/" class="font-display text-lg font-semibold tracking-tight">{ instanceName(ctx) }</a>
					<nav class="flex items-center gap-4 text-sm">
						if user != nil {
							<a href="/dashboard" class="underline">{ loc.T("nav.dashboard") }</a>
							<details class="usermenu">
								<summary class="cursor-pointer list-none font-semibold">{ user.Name }</summary>
								<div class="usermenu-panel">
									<p class="truncate px-3 py-1 font-mono text-xs text-ink/60">{ user.Email }</p>
									<form method="post" action="/auth/logout">
										<button class="block w-full px-3 py-1.5 text-left hover:bg-ink/5" type="submit">{ loc.T("nav.logout") }</button>
									</form>
								</div>
							</details>
						} else {
							<a href="/login" class="underline">{ loc.T("nav.login") }</a>
						}
					</nav>
				</div>
			</header>
			<main class="mx-auto w-full max-w-5xl flex-1 px-4 pb-24">
				{ children... }
			</main>
			<footer class="border-t border-ink/15">
				<div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-2 px-4 py-3 text-xs text-ink/60">
					<span>{ instanceName(ctx) } · Quorum</span>
					<form method="post" action="/lang" class="flex items-center gap-3">
						<input type="hidden" name="next" value={ currentPath(ctx) }/>
						<span class="sr-only">{ loc.T("footer.language") }</span>
						<button class="btn-link" name="lang" value="en" type="submit" lang="en">English</button>
						<button class="btn-link" name="lang" value="fr" type="submit" lang="fr">Français</button>
					</form>
				</div>
			</footer>
		</body>
	</html>
}

templ ErrorPage(p ErrorProps) {
	@layout(p.Loc, p.Loc.T("error.heading"), p.User) {
		<div class="mx-auto max-w-xl py-24">
			<h1 class="font-display text-3xl font-semibold">{ p.Loc.T("error.heading") }</h1>
			<p class="mt-4 text-lg">{ p.Message }</p>
			<p class="mt-8">
				<a href="/" class="btn">{ p.Loc.T("error.back_home") }</a>
			</p>
		</div>
	}
}
