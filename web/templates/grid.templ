package templates

import (
	"fmt"

	"github.com/lporcheron/quorum/internal/poll"
)

// Grid renders the availability grid: timezone selector, results
// matrix (desktop), the vote form, and per-option drill-down (mobile).
// It is the HTMX swap target when the viewer changes timezone.
templ Grid(p PollPageProps) {
	<section id="grid" class="mt-8">
		if p.Poll.Kind == poll.KindTimed {
			<form
				method="get"
				action={ templ.URL(p.pollPath("")) }
				class="mb-4 flex flex-wrap items-center gap-2 text-sm"
				hx-get={ p.gridURL() }
				hx-target="#grid"
				hx-swap="outerHTML"
				hx-trigger="change"
			>
				<label for="tz-select" class="text-ink/70">{ p.Loc.T("poll.tz_label") }</label>
				<select id="tz-select" name="tz" class="field w-auto" data-tz-select>
					if !contains(p.Timezones, p.TZName) {
						<option value={ p.TZName } selected>{ p.TZName }</option>
					}
					for _, tz := range p.Timezones {
						<option value={ tz } selected?={ tz == p.TZName }>{ tz }</option>
					}
				</select>
				if p.EditToken != "" {
					<input type="hidden" name="p" value={ p.EditToken }/>
				}
				<noscript><button class="btn btn-sm">{ p.Loc.T("poll.tz_apply") }</button></noscript>
			</form>
		}
		if p.Poll.Status == poll.StatusPaused {
			<p class="notice">{ p.Loc.T("poll.paused_notice") }</p>
		}
		if len(p.View.Participants) == 0 {
			<p class="mb-4 text-ink/70">{ p.Loc.T("poll.no_votes") }</p>
		} else {
			<p class="mb-4 font-mono text-sm text-ink/70">{ p.Loc.TN("poll.participants", len(p.View.Participants)) }</p>
		}
		if !p.showParticipants() && len(p.View.Participants) > 0 {
			<p class="mb-4 text-sm text-ink/60">{ p.Loc.T("poll.hidden_participants") }</p>
		}

		@matrix(p)
		@voteForm(p)
		@mobileBreakdown(p)
	</section>
}

// matrix is the desktop participants × options table, built as one CSS
// grid so every row shares the column template.
templ matrix(p PollPageProps) {
	if len(p.View.Participants) > 0 {
		<div
			class="qmatrix hidden md:grid"
			style={ fmt.Sprintf("grid-template-columns: minmax(8rem, 14rem) repeat(%d, minmax(5.5rem, 1fr))", len(p.View.Options)) }
		>
			<div class="qcell qhead"></div>
			for i, o := range p.View.Options {
				<div class={ "qcell qhead qopt", templ.KV("qwin", p.View.Tallies[i].Winner) }>
					<span class="text-xs text-ink/60">{ OptionWeekday(p.lang(), o, p.TZ) }</span>
					<span class="font-display text-2xl leading-none">{ OptionDay(o, p.TZ) }</span>
					<span class="text-xs text-ink/60">{ OptionMonthYear(p.lang(), o, p.TZ) }</span>
					if tr := OptionTimeRange(o, p.TZ); tr != "" {
						<span class="mt-1 font-mono text-xs">{ tr }</span>
					}
				</div>
			}
			if p.showParticipants() {
				for _, pa := range p.View.Participants {
					<div class="qcell qname">
						{ pa.Name }
						if p.Me != nil && pa.ID == p.Me.ID {
							<span class="text-ink/50"> ·</span>
						}
					</div>
					for i, o := range p.View.Options {
						<div class={ voteClass(p.View.Votes[pa.ID][o.ID]), templ.KV("qwincell", p.View.Tallies[i].Winner) } title={ p.Loc.T(voteLabelKey(p.View.Votes[pa.ID][o.ID])) }>
							{ voteSymbol(p.View.Votes[pa.ID][o.ID]) }
						</div>
					}
				}
			}
			<div class="qcell qtally-label text-xs text-ink/60">
				if hasWinner(p.View.Tallies) {
					{ p.Loc.T("poll.winner") }
				}
			</div>
			for i := range p.View.Options {
				@tallyCell(p, i)
			}
		</div>
	}
}

// tallyCell shows the count for one option; the winner gets the one
// vivid-blue treatment of the whole interface.
templ tallyCell(p PollPageProps, i int) {
	<div class={ "qcell qtally", templ.KV("qwin", p.View.Tallies[i].Winner) }>
		if p.View.Tallies[i].Winner {
			@quorumRing(p.View.Tallies[i], len(p.View.Participants))
		}
		<span class="font-mono text-lg font-semibold tabular-nums">{ fmt.Sprintf("%d", p.View.Tallies[i].Yes) }</span>
		if p.View.Tallies[i].IfNeedBe > 0 {
			<span class="font-mono text-xs tabular-nums text-ifneedbe">{ fmt.Sprintf("+%d", p.View.Tallies[i].IfNeedBe) }</span>
		}
	</div>
}

// quorumRing closes as answers come in: share of participants that can
// make it (yes + if need be).
templ quorumRing(t poll.Tally, participants int) {
	<svg class="qring" viewBox="0 0 20 20" aria-hidden="true">
		<circle cx="10" cy="10" r="8" fill="none" stroke="currentColor" stroke-opacity="0.25" stroke-width="2.5"></circle>
		<circle
			cx="10" cy="10" r="8" fill="none" stroke="currentColor" stroke-width="2.5"
			stroke-linecap="round"
			stroke-dasharray={ ringDash(t, participants) }
			transform="rotate(-90 10 10)"
		></circle>
	</svg>
}

// voteForm is the single set of vote inputs, one row per option. It
// stacks on mobile and stays a tight list on desktop. Plain form POST:
// voting must work without JavaScript.
templ voteForm(p PollPageProps) {
	if p.Poll.Open() && !p.IsAdmin {
		<form method="post" action={ templ.URL(p.voteAction()) } class="qvote mt-6">
			<h2 class="font-display text-lg font-semibold">
				{ p.Loc.T("vote.your_row") }
				if p.Me != nil {
					<span class="font-sans text-sm font-normal text-ink/60">— { p.Loc.T("vote.editing_as") } { p.Me.Name }</span>
				}
			</h2>
			<div class="mt-3 divide-y divide-ink/10 border-y border-ink/15" data-vote-rows>
				for i, o := range p.View.Options {
					<div class={ "flex flex-wrap items-center gap-x-4 gap-y-1 py-2", templ.KV("qwinrow", p.View.Tallies[i].Winner) }>
						<div class="min-w-40 flex-1">
							<span class="text-sm">{ OptionLabel(p.lang(), o, p.TZ) }</span>
							if p.View.Tallies[i].Winner {
								<span class="qwinbadge">{ p.Loc.T("poll.winner") }</span>
							}
						</div>
						<span class="font-mono text-xs tabular-nums text-ink/60">
							{ fmt.Sprintf("%d", p.View.Tallies[i].Yes) }
							if p.View.Tallies[i].IfNeedBe > 0 {
								{ " " }
								<span class="text-ifneedbe">{ fmt.Sprintf("+%d", p.View.Tallies[i].IfNeedBe) }</span>
							}
						</span>
						@segControl(p, o)
					</div>
				}
			</div>
			<div class="mt-4 flex flex-wrap items-end gap-3">
				<label class="block">
					<span class="lbl">{ p.Loc.T("vote.name_label") }</span>
					<input class="field" type="text" name="name" required value={ meName(p) }/>
				</label>
				<label class="block">
					if p.Poll.RequireVoterEmail {
						<span class="lbl">{ p.Loc.T("vote.email_label") }</span>
						<input class="field" type="email" name="email" required value={ meEmail(p) }/>
					} else {
						<span class="lbl">{ p.Loc.T("vote.email_optional") }</span>
						<input class="field" type="email" name="email" value={ meEmail(p) }/>
					}
				</label>
				if p.Me != nil {
					<button class="btn btn-primary" type="submit">{ p.Loc.T("vote.update") }</button>
				} else {
					<button class="btn btn-primary" type="submit">{ p.Loc.T("vote.submit") }</button>
				}
			</div>
		</form>
		if p.Me != nil {
			<form method="post" action={ templ.URL(p.pollPath("/p/" + p.EditToken + "/delete")) } class="mt-3">
				<button class="btn-link text-sm" type="submit" data-confirm={ p.Loc.T("admin.confirm") }>{ p.Loc.T("vote.leave") }</button>
			</form>
		}
	}
}

// segControl is the three-state control for one option. Radios stay
// real for the no-JS path; quorum.js adds space-to-cycle on top.
templ segControl(p PollPageProps, o poll.Option) {
	<fieldset class="seg" data-seg>
		<legend class="sr-only">{ OptionLabel(p.lang(), o, p.TZ) }</legend>
		<label class="seg-opt seg-yes">
			<input class="sr-only" type="radio" name={ fmt.Sprintf("vote_%d", o.ID) } value="yes" checked?={ p.myVote(o.ID) == poll.VoteYes }/>
			<span>✓ { p.Loc.T("vote.yes") }</span>
		</label>
		<label class="seg-opt seg-ifneedbe">
			<input class="sr-only" type="radio" name={ fmt.Sprintf("vote_%d", o.ID) } value="ifneedbe" checked?={ p.myVote(o.ID) == poll.VoteIfNeedBe }/>
			<span>(✓) { p.Loc.T("vote.ifneedbe") }</span>
		</label>
		<label class="seg-opt seg-no">
			<input class="sr-only" type="radio" name={ fmt.Sprintf("vote_%d", o.ID) } value="no" checked?={ p.myVote(o.ID) == poll.VoteNo }/>
			<span>✕ { p.Loc.T("vote.no") }</span>
		</label>
	</fieldset>
}

// mobileBreakdown gives phones the who-voted-what drill-down that the
// desktop matrix provides, one details element per option.
templ mobileBreakdown(p PollPageProps) {
	if p.showParticipants() && len(p.View.Participants) > 0 {
		<div class="mt-6 md:hidden">
			for i, o := range p.View.Options {
				<details class={ "qmobile-opt", templ.KV("qwinrow", p.View.Tallies[i].Winner) }>
					<summary class="flex items-center justify-between gap-2 py-2">
						<span class="text-sm">{ OptionLabel(p.lang(), o, p.TZ) }</span>
						<span class="font-mono text-xs tabular-nums text-ink/70">
							{ fmt.Sprintf("%d ✓", p.View.Tallies[i].Yes) }
							if p.View.Tallies[i].IfNeedBe > 0 {
								{ fmt.Sprintf(" +%d", p.View.Tallies[i].IfNeedBe) }
							}
						</span>
					</summary>
					<ul class="pb-2 pl-2 text-sm">
						for _, pa := range p.View.Participants {
							<li class="flex items-center gap-2 py-0.5">
								<span class={ voteClass(p.View.Votes[pa.ID][o.ID]), "qdot" }>{ voteSymbol(p.View.Votes[pa.ID][o.ID]) }</span>
								<span>{ pa.Name }</span>
							</li>
						}
					</ul>
				</details>
			}
		</div>
	}
}
