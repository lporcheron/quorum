package templates

import "fmt"

// Home is the landing page: pitch plus the poll creation form. The
// calendar is progressive enhancement; the noscript fallback posts the
// same field names from static rows.
templ Home(p HomeProps) {
	@layout(p.Loc, p.Loc.T("home.title"), p.User) {
		<div class="mx-auto max-w-2xl">
			<div class="pt-16 pb-10">
				<h1 class="font-display text-5xl font-semibold tracking-tight">{ p.Loc.T("home.title") }</h1>
				<p class="mt-4 border-l-2 border-ink pl-4 text-xl">{ p.Loc.T("home.tagline") }</p>
				<p class="mt-3 max-w-prose text-ink/70">{ p.Loc.T("home.blurb") }</p>
			</div>
			<section class="hidden" data-recent-polls data-heading={ p.Loc.T("home.recent") }></section>
			<section class="border-t border-ink/15 pt-8">
				<h2 class="font-display text-2xl font-semibold">{ p.Loc.T("create.heading") }</h2>
				if p.Error != "" {
					<p class="error mt-4" role="alert">{ p.Error }</p>
				}
				<form method="post" action="/polls" class="mt-5 space-y-5" data-create-form>
					<label class="block">
						<span class="lbl">{ p.Loc.T("create.title_label") }</span>
						<input class="field w-full" type="text" name="title" required maxlength="200" placeholder={ p.Loc.T("create.title_placeholder") } value={ p.Title }/>
					</label>

					<fieldset>
						<legend class="lbl">{ p.Loc.T("create.kind_label") }</legend>
						<div class="mt-1 flex gap-2" data-kind-toggle>
							<label class="seg-opt seg-kind">
								<input class="sr-only" type="radio" name="kind" value="timed" checked/>
								<span>{ p.Loc.T("create.kind_timed") }</span>
							</label>
							<label class="seg-opt seg-kind">
								<input class="sr-only" type="radio" name="kind" value="allday"/>
								<span>{ p.Loc.T("create.kind_allday") }</span>
							</label>
						</div>
					</fieldset>

					<label class="block" data-tz-row>
						<span class="lbl">{ p.Loc.T("create.timezone_label") }</span>
						<select class="field" name="timezone" data-tz-select>
							for _, tz := range p.Timezones {
								<option value={ tz } selected?={ tz == "UTC" }>{ tz }</option>
							}
						</select>
					</label>

					<fieldset>
						<legend class="lbl">{ p.Loc.T("create.dates_label") }</legend>
						<p class="mt-1 text-sm text-ink/60" data-js-only hidden>{ p.Loc.T("create.calendar_hint") }</p>
						<div data-calendar hidden></div>
						<div data-slots hidden
							data-l10n-start={ p.Loc.T("create.start_label") }
							data-l10n-duration={ p.Loc.T("create.duration_label") }
							data-l10n-add={ p.Loc.T("create.add_slot") }
							data-l10n-remove={ p.Loc.T("create.remove") }
							data-l10n-copy={ p.Loc.T("create.copy_times") }
						></div>
						<div data-option-inputs></div>
						<noscript>
							<p class="mt-1 text-sm text-ink/60">{ p.Loc.T("create.nojs_hint") }</p>
							<div class="mt-2 space-y-2">
								for range 5 {
									<div class="flex flex-wrap gap-2">
										<label class="block">
											<span class="lbl">{ p.Loc.T("create.date_label") }</span>
											<input class="field" type="date" name="option_date"/>
										</label>
										<label class="block" data-timed-only>
											<span class="lbl">{ p.Loc.T("create.start_label") }</span>
											<input class="field" type="time" name="option_start"/>
										</label>
										<label class="block" data-timed-only>
											<span class="lbl">{ p.Loc.T("create.duration_label") }</span>
											@durationSelect("option_duration")
										</label>
									</div>
								}
							</div>
						</noscript>
					</fieldset>

					<details class="group">
						<summary class="cursor-pointer text-sm font-semibold">{ p.Loc.T("create.more") }</summary>
						<div class="mt-3 space-y-4 border-l border-ink/15 pl-4">
							<label class="block">
								<span class="lbl">{ p.Loc.T("create.description_label") }</span>
								<textarea class="field w-full" name="description" rows="3" maxlength="2000">{ p.Description }</textarea>
							</label>
							<label class="block">
								<span class="lbl">{ p.Loc.T("create.location_label") }</span>
								<input class="field w-full" type="text" name="location" maxlength="200" value={ p.Location }/>
							</label>
							<label class="block">
								<span class="lbl">{ p.Loc.T("create.video_label") }</span>
								<input class="field w-full" type="url" name="video_url" maxlength="500" value={ p.VideoURL }/>
							</label>
							<label class="flex items-center gap-2 text-sm">
								<input type="checkbox" name="hide_participants" value="1"/>
								{ p.Loc.T("create.hide_participants") }
							</label>
							<label class="flex items-center gap-2 text-sm">
								<input type="checkbox" name="require_voter_email" value="1"/>
								{ p.Loc.T("create.require_email") }
							</label>
							<label class="flex items-center gap-2 text-sm">
								<input type="checkbox" name="allow_comments" value="1" checked/>
								{ p.Loc.T("create.allow_comments") }
							</label>
						</div>
					</details>

					<button class="btn btn-primary" type="submit">{ p.Loc.T("create.submit") }</button>
				</form>
			</section>
		</div>
	}
}

// durationSelect offers common durations in minutes.
templ durationSelect(name string) {
	<select class="field" name={ name }>
		for _, d := range []int{15, 30, 45, 60, 90, 120, 180, 240, 480} {
			<option value={ fmt.Sprintf("%d", d) } selected?={ d == 60 }>{ durationLabel(d) }</option>
		}
	</select>
}
