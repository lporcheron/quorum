package templates

import (
	"github.com/lporcheron/quorum/internal/auth"
	"github.com/lporcheron/quorum/internal/i18n"
	"github.com/lporcheron/quorum/internal/poll"
	"github.com/lporcheron/quorum/internal/space"
)

// SpacePollItem decorates a space poll with what the viewer may do.
type SpacePollItem struct {
	poll.SpacePoll
	Manageable bool
}

// DashboardProps feeds the signed-in home: the current space's polls
// plus the user's votes elsewhere.
type DashboardProps struct {
	Loc     *i18n.Locale
	User    *auth.User
	Current space.Space
	Role    space.Role
	Spaces  []space.Membership
	Polls   []SpacePollItem
	Voted   []poll.Poll
}

templ DashboardPage(p DashboardProps) {
	@layout(p.Loc, p.Current.Name+" — Quorum", p.User) {
		<div class="mt-10 flex flex-wrap items-baseline justify-between gap-3">
			<h1 class="font-display text-3xl font-semibold">{ p.Current.Name }</h1>
			<div class="flex flex-wrap items-center gap-3 text-sm">
				if len(p.Spaces) > 1 {
					<form method="post" action="/spaces/switch" class="flex items-center gap-1" data-autosubmit>
						<label for="space-select" class="sr-only">{ p.Loc.T("space.switcher_label") }</label>
						<select id="space-select" name="slug" class="field w-auto">
							for _, m := range p.Spaces {
								<option value={ m.Space.Slug } selected?={ m.Space.ID == p.Current.ID }>{ m.Space.Name }</option>
							}
						</select>
						<button class="btn btn-sm" type="submit">{ p.Loc.T("space.switch") }</button>
					</form>
				}
				if p.Role.AtLeast(space.RoleAdmin) {
					<a class="underline" href={ templ.URL("/spaces/" + p.Current.Slug + "/settings") }>{ p.Loc.T("space.settings_link") }</a>
				}
				<a class="btn btn-primary" href="/">{ p.Loc.T("dashboard.new_poll") }</a>
			</div>
		</div>

		<section class="mt-8">
			<h2 class="panel-title">{ p.Loc.T("dashboard.space_polls") }</h2>
			if len(p.Polls) == 0 {
				<p class="mt-2 text-sm text-ink/60">{ p.Loc.T("dashboard.empty_space") }</p>
			} else {
				<ul class="mt-2 divide-y divide-ink/10 border-y border-ink/15">
					for _, item := range p.Polls {
						<li class="flex flex-wrap items-center justify-between gap-3 py-2 text-sm">
							<span>
								<a class="underline" href={ templ.URL("/polls/" + item.PublicID) }>{ item.Title }</a>
								if item.OwnerName != "" {
									<span class="ml-2 text-xs text-ink/60">{ p.Loc.T("dashboard.by") } { item.OwnerName }</span>
								}
							</span>
							<span class="flex items-center gap-3">
								<span class="font-mono text-xs text-ink/60">{ p.Loc.T("dashboard.status_" + string(item.Status)) }</span>
								if item.Manageable {
									<a class="underline" href={ templ.URL("/polls/" + item.PublicID + "/manage") }>{ p.Loc.T("dashboard.manage") }</a>
								}
							</span>
						</li>
					}
				</ul>
			}
		</section>

		<section class="mt-8">
			<h2 class="panel-title">{ p.Loc.T("dashboard.voted") }</h2>
			if len(p.Voted) == 0 {
				<p class="mt-2 text-sm text-ink/60">{ p.Loc.T("dashboard.empty_voted") }</p>
			} else {
				<ul class="mt-2 divide-y divide-ink/10 border-y border-ink/15">
					for _, pl := range p.Voted {
						<li class="flex items-center justify-between gap-3 py-2 text-sm">
							<a class="underline" href={ templ.URL("/polls/" + pl.PublicID) }>{ pl.Title }</a>
							<span class="font-mono text-xs text-ink/60">{ p.Loc.T("dashboard.status_" + string(pl.Status)) }</span>
						</li>
					}
				</ul>
			}
		</section>

		<section class="mt-12 border-t border-ink/15 pt-6">
			<details>
				<summary class="cursor-pointer text-sm font-semibold">{ p.Loc.T("space.new_heading") }</summary>
				<form method="post" action="/spaces" class="mt-3 flex flex-wrap items-end gap-2">
					<label class="block">
						<span class="lbl">{ p.Loc.T("space.name_label") }</span>
						<input class="field" type="text" name="name" required maxlength="100"/>
					</label>
					<button class="btn" type="submit">{ p.Loc.T("space.create_submit") }</button>
				</form>
			</details>
		</section>
	}
}
